diff --git a/client/ue5/L2KeyboardMover.h b/client/ue5/L2KeyboardMover.h
new file mode 100644
index 0000000..0c3d6f6
--- /dev/null
+++ b/client/ue5/L2KeyboardMover.h
@@ -0,0 +1,180 @@
+// L2KeyboardMover: WASD movement for a custom (UE5) lineage 2 client.
+//
+// pure c++17, no unreal types, so it can be unit tested anywhere and
+// dropped into the UE5 plugin (see L2KeyboardMoverComponent.example.h).
+//
+// what it does better than click-to-move / the official keyboard mode:
+//  - client side prediction: the character moves the frame you press W,
+//    it doesn't wait for the server echo (no input lag).
+//  - camera relative 8-way movement (W/A/S/D + diagonals, normalized).
+//  - sends the minimum: a move packet (0x01, movement=0) only when the
+//    direction changes more than `turn_deg` or every `resend_ms` to push
+//    the lead point forward; a ValidatePosition (0x48) every
+//    `validate_ms`; and CannotMoveAnymore (0x36) on release, so other
+//    players see you stop exactly where you stopped.
+//  - server corrections are blended over `blend_ms` instead of snapping
+//    (small ones ignored, huge ones snapped).
+//
+// it pairs with the l2auth server changes: the server trusts positions
+// within CFG_DESYNC_TOLERANCE, throttles what observers get and detects
+// key release from ValidatePosition.
+#pragma once
+#include <cmath>
+#include <cstdint>
+
+namespace l2 {
+
+struct Vec3 {
+    double x = 0, y = 0, z = 0;
+};
+
+enum class PacketKind { Move, Validate, Stop };
+
+// what to send. map to packets:
+//   Move     -> 0x01 MoveBackwardToLocation: target xyz, origin xyz, movement=0
+//   Validate -> 0x48 ValidatePosition: x, y, z, heading, 0
+//   Stop     -> 0x36 CannotMoveAnymore: x, y, z, heading
+struct Packet {
+    PacketKind kind;
+    int32_t x, y, z;          // origin / current position
+    int32_t tx, ty, tz;       // move target (Move only)
+    int32_t heading;          // 0..65535
+};
+
+struct KeyboardMoverConfig {
+    double lead = 600;          // how far ahead the move target is placed.
+    double resend_ms = 500;     // refresh the lead while holding a key (lead lasts ~5s).
+    double turn_deg = 8;        // direction change that forces a send.
+    double validate_ms = 400;   // ValidatePosition period while moving.
+    double ignore_error = 24;   // server corrections smaller than this are ignored.
+    double snap_error = 300;    // bigger than this: teleport, don't blend.
+    double blend_ms = 150;      // time to absorb a correction.
+    double dead_zone = 0.15;    // analog stick dead zone.
+};
+
+class KeyboardMover {
+public:
+    explicit KeyboardMover(KeyboardMoverConfig cfg = {}) : cfg_(cfg) {}
+
+    void set_speed(double run_speed) { speed_ = run_speed; }
+    void set_position(Vec3 p) { pos_ = p; blend_left_ms_ = 0; }
+    Vec3 position() const { return pos_; }
+    bool moving() const { return moving_; }
+    int32_t heading() const { return heading_; }
+
+    // forward/right in [-1, 1] (W=+1 forward, S=-1, D=+1 right, A=-1),
+    // camera yaw in radians, l2 world axes (x east, y south like the
+    // server: heading 0 = +x).
+    void set_input(double forward, double right, double camera_yaw) {
+        double fx = std::cos(camera_yaw), fy = std::sin(camera_yaw);
+        // right vector: rotate forward by +90 degrees.
+        double rx = -fy, ry = fx;
+        double dx = forward * fx + right * rx;
+        double dy = forward * fy + right * ry;
+        double len = std::sqrt(dx * dx + dy * dy);
+        if (len < cfg_.dead_zone) {
+            want_x_ = want_y_ = 0;
+            return;
+        }
+        // diagonals are not faster (l2 only has run/walk speeds).
+        want_x_ = dx / len;
+        want_y_ = dy / len;
+    }
+
+    // advance one frame. writes up to 2 packets to `out`, returns how many.
+    int tick(double now_ms, double dt_s, Packet out[2]) {
+        int n = 0;
+        bool want = want_x_ != 0 || want_y_ != 0;
+
+        // absorb pending correction.
+        if (blend_left_ms_ > 0) {
+            double step = std::fmin(1.0, (dt_s * 1000.0) / blend_left_ms_);
+            pos_.x += blend_x_ * step;
+            pos_.y += blend_y_ * step;
+            pos_.z += blend_z_ * step;
+            blend_x_ -= blend_x_ * step;
+            blend_y_ -= blend_y_ * step;
+            blend_z_ -= blend_z_ * step;
+            blend_left_ms_ -= dt_s * 1000.0;
+        }
+
+        if (want) {
+            // predict locally right away.
+            pos_.x += want_x_ * speed_ * dt_s;
+            pos_.y += want_y_ * speed_ * dt_s;
+            heading_ = to_heading(want_x_, want_y_);
+
+            double dot = want_x_ * sent_x_ + want_y_ * sent_y_;
+            bool turned = dot < std::cos(cfg_.turn_deg * 3.14159265358979 / 180.0);
+            bool stale = now_ms - last_move_ms_ >= cfg_.resend_ms;
+            if (!moving_ || turned || stale) {
+                out[n++] = make(PacketKind::Move);
+                sent_x_ = want_x_;
+                sent_y_ = want_y_;
+                last_move_ms_ = now_ms;
+                last_validate_ms_ = now_ms;
+            } else if (now_ms - last_validate_ms_ >= cfg_.validate_ms) {
+                out[n++] = make(PacketKind::Validate);
+                last_validate_ms_ = now_ms;
+            }
+            moving_ = true;
+        } else if (moving_) {
+            // released: stop exactly here for everybody.
+            out[n++] = make(PacketKind::Stop);
+            out[n++] = make(PacketKind::Validate);
+            moving_ = false;
+            sent_x_ = sent_y_ = 0;
+        }
+        return n;
+    }
+
+    // ValidateLocation / position correction for our own character.
+    void on_server_position(Vec3 server) {
+        double ex = server.x - pos_.x, ey = server.y - pos_.y, ez = server.z - pos_.z;
+        double err = std::sqrt(ex * ex + ey * ey);
+        if (err < cfg_.ignore_error) {
+            pos_.z = server.z;  // no geodata on our side: trust the server's z.
+            return;
+        }
+        if (err > cfg_.snap_error) {
+            set_position(server);
+            return;
+        }
+        blend_x_ = ex;
+        blend_y_ = ey;
+        blend_z_ = ez;
+        blend_left_ms_ = cfg_.blend_ms;
+    }
+
+private:
+    static int32_t to_heading(double dx, double dy) {
+        double a = std::atan2(dy, dx);
+        if (a < 0) a += 2.0 * 3.14159265358979;
+        return static_cast<int32_t>(a * 65536.0 / (2.0 * 3.14159265358979)) & 0xffff;
+    }
+
+    Packet make(PacketKind kind) const {
+        Packet p{};
+        p.kind = kind;
+        p.x = static_cast<int32_t>(std::lround(pos_.x));
+        p.y = static_cast<int32_t>(std::lround(pos_.y));
+        p.z = static_cast<int32_t>(std::lround(pos_.z));
+        p.tx = static_cast<int32_t>(std::lround(pos_.x + want_x_ * cfg_.lead));
+        p.ty = static_cast<int32_t>(std::lround(pos_.y + want_y_ * cfg_.lead));
+        p.tz = p.z;
+        p.heading = heading_;
+        return p;
+    }
+
+    KeyboardMoverConfig cfg_;
+    Vec3 pos_;
+    double speed_ = 120;
+    double want_x_ = 0, want_y_ = 0;
+    double sent_x_ = 0, sent_y_ = 0;
+    double last_move_ms_ = -1e9, last_validate_ms_ = -1e9;
+    bool moving_ = false;
+    int32_t heading_ = 0;
+    double blend_x_ = 0, blend_y_ = 0, blend_z_ = 0, blend_left_ms_ = 0;
+};
+
+}  // namespace l2
diff --git a/client/ue5/L2KeyboardMoverComponent.example.h b/client/ue5/L2KeyboardMoverComponent.example.h
new file mode 100644
index 0000000..7d7ddab
--- /dev/null
+++ b/client/ue5/L2KeyboardMoverComponent.example.h
@@ -0,0 +1,83 @@
+// EXAMPLE glue for the UE5 client (L2Net plugin). Not compiled here: no
+// Unreal in this environment. It shows where L2KeyboardMover plugs in.
+//
+// 1. Project Settings > Input: axis "MoveForward" (W=+1, S=-1),
+//    "MoveRight" (D=+1, A=-1). Enhanced Input works the same way.
+// 2. Add this component to the local player's pawn.
+// 3. Make WASD the default: in the options menu, "Movement: Keyboard (WASD)"
+//    on by default; click-to-move still works (it sends movement=1).
+//
+// Coordinates: L2 uses x east, y south, z up, 1 unit ~ 1 UE unit if you
+// import the world at that scale. Heading 0 = +x.
+#pragma once
+
+#include "CoreMinimal.h"
+#include "Components/ActorComponent.h"
+#include "L2KeyboardMover.h"
+#include "L2NetSubsystem.h"            // from the L2Net plugin
+#include "L2KeyboardMoverComponent.generated.h"
+
+UCLASS(ClassGroup = (L2), meta = (BlueprintSpawnableComponent))
+class UL2KeyboardMoverComponent : public UActorComponent
+{
+    GENERATED_BODY()
+
+public:
+    UL2KeyboardMoverComponent() { PrimaryComponentTick.bCanEverTick = true; }
+
+    // call from the pawn's input bindings.
+    void SetMoveInput(float Forward, float Right) { InForward = Forward; InRight = Right; }
+
+    // call when UserInfo arrives (spawn) and when run speed changes.
+    void ResetTo(const FVector& L2Pos, float RunSpeed)
+    {
+        Mover.set_speed(RunSpeed);
+        Mover.set_position({L2Pos.X, L2Pos.Y, L2Pos.Z});
+    }
+
+    // call when the server sends ValidateLocation (0x61) for our own object.
+    void OnServerPosition(const FVector& L2Pos) { Mover.on_server_position({L2Pos.X, L2Pos.Y, L2Pos.Z}); }
+
+    virtual void TickComponent(float Dt, ELevelTick, FActorComponentTickFunction*) override
+    {
+        const APlayerController* PC = GetWorld()->GetFirstPlayerController();
+        const double Yaw = FMath::DegreesToRadians(PC ? PC->GetControlRotation().Yaw : 0.0);
+        Mover.set_input(InForward, InRight, Yaw);
+
+        l2::Packet Out[2];
+        const int N = Mover.tick(GetWorld()->GetTimeSeconds() * 1000.0, Dt, Out);
+        for (int i = 0; i < N; ++i)
+            Send(Out[i]);
+
+        // the pawn follows the prediction every frame (no waiting for the echo).
+        const l2::Vec3 P = Mover.position();
+        GetOwner()->SetActorLocation(FVector(P.x, P.y, P.z));
+        if (Mover.moving())
+            GetOwner()->SetActorRotation(FRotator(0, Mover.heading() * 360.0 / 65536.0, 0));
+    }
+
+private:
+    void Send(const l2::Packet& P)
+    {
+        UL2NetSubsystem* Net = GetWorld()->GetGameInstance()->GetSubsystem<UL2NetSubsystem>();
+        TArray<uint8> B;
+        auto D = [&B](int32 V) { B.Append(reinterpret_cast<uint8*>(&V), 4); };
+        switch (P.kind)
+        {
+        case l2::PacketKind::Move:      // MoveBackwardToLocation, movement = 0 (keyboard)
+            B.Add(0x01); D(P.tx); D(P.ty); D(P.tz); D(P.x); D(P.y); D(P.z); D(0);
+            break;
+        case l2::PacketKind::Validate:  // ValidatePosition
+            B.Add(0x48); D(P.x); D(P.y); D(P.z); D(P.heading); D(0);
+            break;
+        case l2::PacketKind::Stop:      // CannotMoveAnymore
+            B.Add(0x36); D(P.x); D(P.y); D(P.z); D(P.heading);
+            break;
+        }
+        Net->SendGamePacket(B);
+    }
+
+    l2::KeyboardMover Mover;
+    float InForward = 0.f;
+    float InRight = 0.f;
+};
diff --git a/client/ue5/test_keyboard_mover.cpp b/client/ue5/test_keyboard_mover.cpp
new file mode 100644
index 0000000..6a1a519
--- /dev/null
+++ b/client/ue5/test_keyboard_mover.cpp
@@ -0,0 +1,94 @@
+// g++ -std=c++17 -O2 -Wall -Wextra test_keyboard_mover.cpp -o test_keyboard_mover && ./test_keyboard_mover
+#include "L2KeyboardMover.h"
+#include <cstdio>
+#include <cmath>
+
+static int failures = 0;
+#define CHECK(cond, ...) do { if (cond) { std::printf("  PASS "); } else { std::printf("  FAIL "); failures++; } std::printf(__VA_ARGS__); std::printf("\n"); } while (0)
+
+int main() {
+    using namespace l2;
+    const double dt = 1.0 / 60.0;
+
+    // 1. pressing W moves the same frame (prediction) and sends one Move.
+    {
+        KeyboardMover m;
+        m.set_speed(120);
+        m.set_position({0, 0, 0});
+        m.set_input(1, 0, 0);
+        Packet out[2];
+        int n = m.tick(0, dt, out);
+        CHECK(n == 1 && out[0].kind == PacketKind::Move, "first frame sends a Move");
+        CHECK(m.position().x > 1.9, "character moved locally on the first frame (%.2f)", m.position().x);
+        CHECK(out[0].tx - out[0].x == 600, "lead point 600 ahead");
+    }
+    // 2. holding W 3s while steering the camera slowly: few packets.
+    {
+        KeyboardMover m;
+        m.set_speed(120);
+        int moves = 0, validates = 0;
+        double yaw = 0;
+        for (int f = 0; f < 180; f++) {
+            yaw += 0.003;  // ~10 degrees per second
+            m.set_input(1, 0, yaw);
+            Packet out[2];
+            int n = m.tick(f * 1000.0 * dt, dt, out);
+            for (int i = 0; i < n; i++) {
+                moves += out[i].kind == PacketKind::Move;
+                validates += out[i].kind == PacketKind::Validate;
+            }
+        }
+        CHECK(moves <= 14, "3s of steering: %d moves (<= ~4/s)", moves);
+        CHECK(validates <= 8, "and %d validates", validates);
+        CHECK(std::fabs(std::hypot(m.position().x, m.position().y) - 360) < 15, "walked ~360 units in 3s at speed 120 (%.1f)", std::hypot(m.position().x, m.position().y));
+    }
+    // 3. sharp turn (W -> D) sends immediately.
+    {
+        KeyboardMover m;
+        Packet out[2];
+        m.set_input(1, 0, 0);
+        m.tick(0, dt, out);
+        m.set_input(0, 1, 0);
+        int n = m.tick(16, dt, out);
+        CHECK(n == 1 && out[0].kind == PacketKind::Move, "90 degree turn sends a Move right away");
+        CHECK(out[0].ty > out[0].y && out[0].tx == out[0].x, "D = strafe right (+y in l2 axes)");
+    }
+    // 4. diagonal is not faster.
+    {
+        KeyboardMover a, b;
+        Packet out[2];
+        a.set_input(1, 0, 0);
+        b.set_input(1, 1, 0);
+        for (int f = 0; f < 60; f++) { a.tick(f * 16.6, dt, out); b.tick(f * 16.6, dt, out); }
+        double da = std::hypot(a.position().x, a.position().y), db = std::hypot(b.position().x, b.position().y);
+        CHECK(std::fabs(da - db) < 0.5, "W+D covers the same distance as W (%.1f vs %.1f)", db, da);
+    }
+    // 5. release: Stop + Validate exactly where we are.
+    {
+        KeyboardMover m;
+        Packet out[2];
+        m.set_input(1, 0, 0);
+        for (int f = 0; f < 30; f++) m.tick(f * 16.6, dt, out);
+        m.set_input(0, 0, 0);
+        int n = m.tick(500, dt, out);
+        CHECK(n == 2 && out[0].kind == PacketKind::Stop && out[1].kind == PacketKind::Validate, "release sends Stop + Validate");
+        CHECK(out[0].x == (int) std::lround(m.position().x), "stop at the predicted position");
+        CHECK(m.tick(520, dt, out) == 0, "nothing more while idle");
+    }
+    // 6. corrections: small ignored, medium blended, big snapped.
+    {
+        KeyboardMover m;
+        Packet out[2];
+        m.set_position({100, 100, 0});
+        m.on_server_position({110, 100, 5});
+        CHECK(m.position().x == 100 && m.position().z == 5, "10 units: ignored (z taken from server)");
+        m.on_server_position({200, 100, 5});
+        CHECK(m.position().x == 100, "100 units: not snapped");
+        for (int f = 0; f < 12; f++) m.tick(f * 16.6, dt, out);
+        CHECK(std::fabs(m.position().x - 200) < 1.0, "100 units: blended in ~150ms (%.2f)", m.position().x);
+        m.on_server_position({5000, 100, 5});
+        CHECK(m.position().x == 5000, "big error: snapped");
+    }
+    std::printf(failures ? "%d FAILED\n" : "all passed\n", failures);
+    return failures != 0;
+}
diff --git a/config.h b/config.h
new file mode 100644
index 0000000..1dde69d
--- /dev/null
+++ b/config.h
@@ -0,0 +1,135 @@
+#ifndef L2_CONFIG_H
+#define L2_CONFIG_H
+/*
+ * game server tunables. everything that changes how much the client
+ * has to process (and therefore its fps in crowded places) lives here.
+ */
+
+/* ---------------------------------------------------------------- threads */
+// world simulation rate. the original server ticked once per second,
+// which made movement, attacks and casts land in 1 second bursts.
+#ifndef CFG_TICK_MS
+#define CFG_TICK_MS 100
+#endif
+// threads that flush per-connection output buffers to sockets.
+// 0 = automatic (cpu count - 1, clamped to [1, CFG_MAX_SENDERS]).
+#ifndef CFG_SENDER_THREADS
+#define CFG_SENDER_THREADS 0
