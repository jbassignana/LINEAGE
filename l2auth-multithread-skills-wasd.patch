+static void handle_leave_world(struct state *state, struct connection *conn)
+{
+    assert(state);
+    assert(conn);
+    if (conn->character) {
+        character_leave_world(state, conn->character);
+        // the slot can be reused by an npc: never keep pointing at it.
+        conn->character->conn = 0;
+        conn->character = 0;
+    }
+    push_response(conn, 1,
+                  "%h", 0,
+                  "%c", 0x7e);
+}
+
+static void handle_restart(struct state *state, struct connection *conn)
+{
+    assert(state);
+    assert(conn);
+    character_leave_world(state, conn->character);
+    conn->character->conn = 0;
+    conn->character = 0;
+    push_response(conn, 1,
+                  "%h", 0,
+                  "%c", 0x5f,
+                  "%u", 1);
+    handle_send_character_list(state, conn);
+}
diff --git a/gs_move.c b/gs_move.c
new file mode 100644
index 0000000..fdc1cae
--- /dev/null
+++ b/gs_move.c
@@ -0,0 +1,485 @@
+/*
+ * movement.
+ *
+ * - positions are interpolated from real time (ms), so they are right
+ *   between ticks and independent of CFG_TICK_MS.
+ * - the client position is trusted within CFG_DESYNC_TOLERANCE (smooth,
+ *   no rubber banding) and corrected beyond it (no teleport hacks). the
+ *   original sent a ValidateLocation to the moving player on EVERY tick
+ *   while it was in sync (the comparison was inverted), which made the
+ *   client snap/stutter while walking.
+ * - keyboard movement (arrow keys / wasd, `movement == 0` in the move
+ *   packet) is first class: the mover always gets an immediate echo, the
+ *   rest of the players get direction changes throttled, and the far
+ *   point the client sends is clamped.
+ */
+
+static void update_position(struct state *state, struct character *c)
+{
+    if (c->action_type != moving)
+        return;
+    struct action_moving *m = &c->action_payload.moving;
+    u64 t = state->now_ms - m->start_ms;
+    if (!m->duration_ms || t >= m->duration_ms) {
+        c->x = m->target_x;
+        c->y = m->target_y;
+        c->z = m->target_z;
+        return;
+    }
+    float f = (float) t / (float) m->duration_ms;
+    c->x = m->src_x + (s32) ((float) (m->target_x - m->src_x) * f);
+    c->y = m->src_y + (s32) ((float) (m->target_y - m->src_y) * f);
+    c->z = m->src_z + (s32) ((float) (m->target_z - m->src_z) * f);
+}
+
+static void send_validate_location(struct state *state, struct connection *to, struct character *c)
+{
+    push_response(to, 1,
+                  "%h", 0,
+                  "%c", 0x61,
+                  "%u", get_character_id(state, c),
+                  "%u", c->x,
+                  "%u", c->y,
+                  "%u", c->z,
+                  "%u", c->heading);
+}
+
+static void keyboard_broadcast_move(struct state *state, struct character *c)
+{
+    struct action_moving *m = &c->action_payload.moving;
+    update_position(state, c);
+    broadcast_others(state,
+                     c, 1,
+                     "%h", 0,
+                     "%c", 0x01,
+                     "%u", get_character_id(state, c),
+                     "%u", m->target_x,
+                     "%u", m->target_y,
+                     "%u", m->target_z,
+                     "%u", c->x,
+                     "%u", c->y,
+                     "%u", c->z);
+    float dx = (float) (m->target_x - c->x);
+    float dy = (float) (m->target_y - c->y);
+    float len = sqrtf(dx * dx + dy * dy);
+    if (len > 0.0f) {
+        c->last_bcast_dir_x = dx / len;
+        c->last_bcast_dir_y = dy / len;
+    }
+    c->last_others_move_bcast_ms = state->now_ms;
+    c->keyboard_bcast_pending = 0;
+}
+
+static void move_to_ex(struct state *state, struct character *character,
+                       s32 x, s32 y, s32 z, u32 offset, u32 target_id,
+                       int queue_action, int keyboard)
+{
+    assert(state);
+    assert(character);
+
+    update_position(state, character);
+
+    if (queue_action && character->action_type != moving) {
+        character->prev_action_type = character->action_type;
+        character->prev_action_payload = character->action_payload;
+    }
+
+    int was_keyboard = character->action_type == moving &&
+                       character->action_payload.moving.keyboard;
+
+    character->action_type = moving;
+    character->action_payload = (union action_payload) {0};
+
+    struct action_moving *m = &character->action_payload.moving;
+    m->queue_action = queue_action;
+    m->offset = offset;
+    m->target_id = target_id;
+    m->keyboard = keyboard;
+    m->src_x = character->x;
+    m->src_y = character->y;
+    m->src_z = character->z;
+
+    float dx = (float) (x - character->x);
+    float dy = (float) (y - character->y);
+    float dz = (float) (z - character->z);
+    float d = sqrtf(dx * dx + dy * dy + dz * dz);
+    float travel = d - (float) offset;
+    if (travel < 0.0f)
+        travel = 0.0f;
+
+    if (d > 0.0f) {
+        m->target_x = character->x + (s32) (dx / d * travel);
+        m->target_y = character->y + (s32) (dy / d * travel);
+        m->target_z = character->z + (s32) (dz / d * travel);
+        character->heading = heading_from((s32) dx, (s32) dy);
+    } else {
+        m->target_x = character->x;
+        m->target_y = character->y;
+        m->target_z = character->z;
+    }
+
+    float speed = (float) (character->run_speed ? character->run_speed : 1);
+    m->duration_ms = (u64) (travel * 1000.0f / speed);
+    m->start_ms = state->now_ms;
+    m->last_repath_ms = state->now_ms;
+
+    if (target_id) {
+        character->keyboard_moving = 0;
+        character->keyboard_bcast_pending = 0;
+        broadcast(state,
+                  character, 1,
+                  "%h", 0,
+                  "%c", 0x60,
+                  "%u", get_character_id(state, character),
+                  "%u", target_id,
+                  "%u", offset,
+                  "%u", character->x,
+                  "%u", character->y,
+                  "%u", character->z);
+        return;
+    }
+
+    if (!keyboard || !character->conn) {
+        character->keyboard_moving = 0;
+        character->keyboard_bcast_pending = 0;
+        broadcast(state,
+                  character, 1,
+                  "%h", 0,
+                  "%c", 0x01,
+                  "%u", get_character_id(state, character),
+                  "%u", m->target_x,
+                  "%u", m->target_y,
+                  "%u", m->target_z,
+                  "%u", character->x,
+                  "%u", character->y,
+                  "%u", character->z);
+        return;
+    }
+
+    // keyboard: the mover always gets an immediate answer, so the input
+    // feels instant on its screen.
+    push_response(character->conn, 1,
+                  "%h", 0,
+                  "%c", 0x01,
+                  "%u", get_character_id(state, character),
+                  "%u", m->target_x,
+                  "%u", m->target_y,
+                  "%u", m->target_z,
+                  "%u", character->x,
+                  "%u", character->y,
+                  "%u", character->z);
+
+    // everybody else: only when the direction really changed or every
+    // CFG_KEYBOARD_BCAST_MS. holding a key and steering with the camera
+    // makes the client send many tiny corrections; observers don't need
+    // all of them, and their client doesn't have to process them.
+    float ndx = 0.0f, ndy = 0.0f;
+    float len = sqrtf(dx * dx + dy * dy);
+    if (len > 0.0f) {
+        ndx = dx / len;
+        ndy = dy / len;
+    }
+    float dot = ndx * character->last_bcast_dir_x + ndy * character->last_bcast_dir_y;
+    float cos_limit = cosf((float) CFG_KEYBOARD_BCAST_ANGLE * PI_F / 180.0f);
+    int turned = dot < cos_limit;
+    int stale = state->now_ms - character->last_others_move_bcast_ms >= CFG_KEYBOARD_BCAST_MS;
+    if (!was_keyboard || !character->keyboard_moving || turned || stale)
+        keyboard_broadcast_move(state, character);
+    else
+        character->keyboard_bcast_pending = 1;
+    character->keyboard_moving = 1;
+}
+
+static void move_to(struct state *state, struct character *character, s32 x, s32 y, s32 z, u32 offset, u32 target_id, int queue_action)
+{
+    move_to_ex(state, character, x, y, z, offset, target_id, queue_action, 0);
+}
+
+static void stop_moving(struct state *state, struct character *c, int notify_self)
+{
+    update_position(state, c);
+    c->action_type = idle;
+    c->action_payload = (union action_payload) {0};
+    c->prev_action_type = idle;
+    c->prev_action_payload = (union action_payload) {0};
+    c->keyboard_moving = 0;
+    c->keyboard_bcast_pending = 0;
+    if (notify_self)
+        broadcast(state,
+                  c, 1,
+                  "%h", 0,
+                  "%c", 0x47,
+                  "%u", get_character_id(state, c),
+                  "%u", c->x,
+                  "%u", c->y,
+                  "%u", c->z,
+                  "%u", c->heading);
+    else
+        broadcast_others(state,
+                         c, 1,
+                         "%h", 0,
+                         "%c", 0x47,
+                         "%u", get_character_id(state, c),
+                         "%u", c->x,
+                         "%u", c->y,
+                         "%u", c->z,
+                         "%u", c->heading);
+}
+
+static void moving_update(struct state *state, struct character *character)
+{
+    assert(state);
+    assert(character);
+
+    struct action_moving *m = &character->action_payload.moving;
+    update_position(state, character);
+    int done = state->now_ms - m->start_ms >= m->duration_ms;
+
+    if (m->target_id) {
+        struct character *target = get_character_by_id(state, m->target_id);
+
+        // stop movement if the target is no longer valid.
+        if (!target || !target->active || !target->in_world) {
+            stop_moving(state, character, 1);
+            return;
+        }
+
+        // arrived next to the target: continue with the queued action.
+        u64 d2 = distance_between_characters(character, target);
+        u64 reach = (u64) m->offset + 4;
+        if (d2 <= reach * reach) {
+            m->target_x = character->x;
+            m->target_y = character->y;
+            m->target_z = character->z;
+            goto arrived;
+        }
+
+        // the target moved: re-path, but not every tick (the original
+        // re-sent MoveToPawn + a full NpcInfo every single update).
+        u64 drift = distance_between(m->target_x, m->target_y, m->target_z,
+                                     target->x, target->y, target->z);
+        u64 drift_limit = (u64) m->offset + CFG_FOLLOW_REPATH_DIST;
+        int repath_due = state->now_ms - m->last_repath_ms >= CFG_FOLLOW_REPATH_MS;
+        if (done || (repath_due && drift > drift_limit * drift_limit)) {
+            move_to(state, character, target->x, target->y, target->z,
+                    m->offset, m->target_id, 0);
+        }
+        return;
+    }
+
+    if (!done)
+        return;
+
+arrived:
+    character->x = m->target_x;
+    character->y = m->target_y;
+    character->z = m->target_z;
+
+    int was_keyboard = m->keyboard;
+    character->action_type = character->prev_action_type;
+    character->action_payload = character->prev_action_payload;
+
+    character->prev_action_type = idle;
+    character->prev_action_payload = (union action_payload) {0};
+    character->keyboard_moving = 0;
+    character->keyboard_bcast_pending = 0;
+
+    // final position for the observers (not for the mover itself, it
+    // already is there on its screen).
+    if (!was_keyboard)
+        broadcast_others(state,
+                         character, 1,
+                         "%h", 0,
+                         "%c", 0x61,
+                         "%u", get_character_id(state, character),
+                         "%u", character->x,
+                         "%u", character->y,
+                         "%u", character->z,
+                         "%u", character->heading);
+
+    // when arrived, if there was a queued action (walk closer -> attack
+    // or cast), run it right away instead of waiting for the next tick.
+    if (character->action_type != moving)
+        character_update(state, character);
+}
+
+static int position_acceptable(struct character *c, s32 x, s32 y, s32 z)
+{
+    u64 tol = CFG_DESYNC_TOLERANCE;
+    return distance_between(c->x, c->y, c->z, x, y, z) <= tol * tol;
+}
+
+static void correct_client(struct state *state, struct character *c)
+{
+    if (!c->conn)
+        return;
+    if (state->now_ms - c->last_correction_ms < CFG_CORRECTION_COOLDOWN_MS)
+        return;
+    c->last_correction_ms = state->now_ms;
+    send_validate_location(state, c->conn, c);
+}
+
+static void handle_movement(struct state *state, struct connection *conn, byte *req)
+{
+    assert(state);
+    assert(conn);
+    assert(req);
+
+    s32 target_x = 0;
+    s32 target_y = 0;
+    s32 target_z = 0;
+    s32 origin_x = 0;
+    s32 origin_y = 0;
+    s32 origin_z = 0;
+    s32 movement = 1;
+
+    pscanf(req,
+           "%u", &target_x,
+           "%u", &target_y,
+           "%u", &target_z,
+           "%u", &origin_x,
+           "%u", &origin_y,
+           "%u", &origin_z,
+           "%u", &movement);
+
+    struct character *c = conn->character;
+    if (c->action_type == dead || state->now_ms < c->stunned_until_ms) {
+        action_failed(c);
+        return;
+    }
+
+    update_position(state, c);
+    // the original trusted the origin blindly (free teleport).
+    if (position_acceptable(c, origin_x, origin_y, origin_z)) {
+        c->x = origin_x;
+        c->y = origin_y;
+        c->z = origin_z;
+    } else {
+        c->last_correction_ms = 0;
+        correct_client(state, c);
+    }
+    c->last_client_update_ms = state->now_ms;
+
+    // 0 = cursor keys / wasd, 1 = mouse.
+    int keyboard = movement == 0;
+    if (keyboard) {
+        float dx = (float) (target_x - c->x);
+        float dy = (float) (target_y - c->y);
+        float len = sqrtf(dx * dx + dy * dy);
+        if (len > CFG_KEYBOARD_MAX_LEAD) {
+            target_x = c->x + (s32) (dx / len * CFG_KEYBOARD_MAX_LEAD);
+            target_y = c->y + (s32) (dy / len * CFG_KEYBOARD_MAX_LEAD);
+        }
+    }
+
+    // moving cancels whatever was queued (attack after approach, cast).
+    c->prev_action_type = idle;
+    c->prev_action_payload = (union action_payload) {0};
+    if (c->action_type == casting || c->action_type == attacking)
+        c->action_type = idle;
+
+    if (keyboard)
+        c->last_keyboard_move_ms = state->now_ms;
+    move_to_ex(state, c, target_x, target_y, target_z, 0, 0, 0, keyboard);
+}
+
+static void handle_validate_position(struct state *state, struct connection *conn, byte *req)
+{
+    assert(state);
+    assert(conn);
+    assert(req);
+
+    s32 x = 0, y = 0, z = 0;
+    u32 heading = 0;
+    pscanf(req,
+           "%u", &x,
+           "%u", &y,
+           "%u", &z,
+           "%u", &heading);
+
+    struct character *c = conn->character;
+    c->client_x = x;
+    c->client_y = y;
+    c->last_client_update_ms = state->now_ms;
+    update_position(state, c);
+
+#ifdef L2_TEST_TELEPORT
+    // test builds only: lets the bots spread around the map instantly.
+    if (heading == 0x7e57) {
+        c->x = x;
+        c->y = y;
+        c->z = z;
+        if (c->action_type == moving)
+            c->action_type = idle;
+        return;
+    }
+#endif
+
+    int client_still = c->last_validate_x == x && c->last_validate_y == y;
+    c->last_validate_x = x;
+    c->last_validate_y = y;
+
+    if (!position_acceptable(c, x, y, z)) {
+        correct_client(state, c);
+        return;
+    }
+
+    // keyboard released: the client stands still but we are walking it.
+    if (client_still && c->action_type == moving && c->action_payload.moving.keyboard &&
+        state->now_ms - c->last_keyboard_move_ms >= CFG_KEYBOARD_RELEASE_MS) {
+        c->x = x;
+        c->y = y;
+        c->z = z;
+        c->action_payload.moving.target_x = x;
+        c->action_payload.moving.target_y = y;
+        c->action_payload.moving.target_z = z;
+        stop_moving(state, c, 0);
+        return;
+    }
+    if (c->action_type != moving)
+        c->heading = (s32) (heading & 0xffff);
+
+    // in sync: follow the client, it's the one drawing the character.
+    // when moving, re-base the interpolation from the client position so
+    // the server doesn't slowly drift away from it.
+    c->x = x;
+    c->y = y;
+    c->z = z;
+    if (c->action_type == moving) {
+        struct action_moving *m = &c->action_payload.moving;
+        float dx = (float) (m->target_x - x);
+        float dy = (float) (m->target_y - y);
+        float dz = (float) (m->target_z - z);
+        float left = sqrtf(dx * dx + dy * dy + dz * dz);
+        float speed = (float) (c->run_speed ? c->run_speed : 1);
+        m->src_x = x;
+        m->src_y = y;
+        m->src_z = z;
+        m->start_ms = state->now_ms;
+        m->duration_ms = (u64) (left * 1000.0f / speed);
+    }
+}
+
+static void handle_cannot_move_anymore(struct state *state, struct connection *conn, byte *req)
+{
+    s32 x = 0, y = 0, z = 0;
+    u32 heading = 0;
+    pscanf(req,
+           "%u", &x,
+           "%u", &y,
+           "%u", &z,
+           "%u", &heading);
+
+    struct character *c = conn->character;
+    update_position(state, c);
+    if (position_acceptable(c, x, y, z)) {
+        c->x = x;
+        c->y = y;
+        c->z = z;
+    } else {
+        correct_client(state, c);
+    }
+    c->heading = (s32) (heading & 0xffff);
+    if (c->action_type == moving && !c->action_payload.moving.target_id)
+        stop_moving(state, c, 0);
+}
diff --git a/gs_world.c b/gs_world.c
new file mode 100644
index 0000000..07c4202
--- /dev/null
+++ b/gs_world.c
@@ -0,0 +1,669 @@
+/*
+ * world: stats, spawning, and interest management.
+ *
+ * interest management is the main server-side fix for low client fps:
+ * the c4 client creates an actor (mesh, animation, name plate) for every
+ * object the server tells it about and processes every packet about
+ * them. the original server told every client about everything in the
+ * whole world. now each client only knows the objects within
+ * CFG_VIEW_ENTER, and never more than CFG_MAX_KNOWN of them (nearest
+ * first). visibility is computed for all players in parallel.
+ */
+
+#define PI_F 3.14159265f
+
+static int knows(struct character *observer, u32 id)
+{
+    if (id >= 1024)
+        return 0;
+    return (observer->known[id >> 6] >> (id & 63)) & 1;
+}
+
+static void set_known(struct character *observer, u32 id, int value)
+{
+    u64 bit = (u64) 1 << (id & 63);
+    if (value)
+        observer->known[id >> 6] |= bit;
+    else
+        observer->known[id >> 6] &= ~bit;
+}
+
+static s32 heading_from(s32 dx, s32 dy)
+{
+    // l2 headings go from 0 to 65535 for a full turn.
+    double angle = atan2((double) dy, (double) dx);
+    if (angle < 0)
+        angle += 2.0 * 3.14159265358979;
+    return (s32) (angle * 65536.0 / (2.0 * 3.14159265358979)) & 0xffff;
+}
+
+static int is_dagger_class(u32 class_id)
+{
+    switch (class_id) {
+    case 7:   // rogue
+    case 8:   // treasure hunter
+    case 22:  // elven scout
+    case 23:  // plains walker
+    case 35:  // assassin
+    case 36:  // abyss walker
+    case 93:  // adventurer
+    case 101: // wind rider
+    case 108: // ghost hunter
+        return 1;
+    default:
+        return 0;
+    }
+}
+
+static int is_mystic_class(u32 class_id)
+{
+    return (class_id >= 10 && class_id <= 17) ||
+           (class_id >= 25 && class_id <= 30) ||
+           (class_id >= 38 && class_id <= 43) ||
+           (class_id >= 49 && class_id <= 52) ||
+           (class_id >= 94 && class_id <= 98) ||
+           (class_id >= 103 && class_id <= 105) ||
+           (class_id >= 110 && class_id <= 112) ||
+           (class_id >= 115 && class_id <= 116);
+}
+
+enum { race_human, race_elf, race_dark_elf, race_orc, race_dwarf };
+
+static void character_init_stats(struct state *state, struct character *c)
+{
+    (void) state;
+    u32 lvl = c->level ? c->level : 1;
+    double lvl_mul = 1.0 + 0.04 * (double) (lvl - 1);
+
+    // fighter baseline.
+    double hp = 420, mp = 140, cp = 300;
+    double p_atk = 80, p_def = 80, m_atk = 30, m_def = 60;
+    u32 atk_spd = 300, cast_spd = 333, run = 120, walk = 80;
+    u32 crit = 40, acc = 33, evasion = 33;
+
+    if (is_mystic_class(c->class_id)) {
+        hp = 300; mp = 320; cp = 200;
+        p_atk = 40; p_def = 55; m_atk = 95; m_def = 80;
+        atk_spd = 280; cast_spd = 380; run = 120; crit = 20;
+    }
+    if (is_dagger_class(c->class_id)) {
+        // daggers: fast, critical, evasive, fragile.
+        hp = 380; p_atk = 78; p_def = 70;
+        atk_spd = 433; run = 132; crit = 90; evasion = 45; acc = 38;
+    }
+    if (c->race_id == race_dwarf) {
+        // "dwarven might": the toughest hitters in melee range.
+        hp *= 1.20;
+        p_atk *= 1.18;
+        p_def *= 1.12;
+        crit += 15;
+        acc += 3;
+        run = 115;
+        c->dwarven_craft = 1;
+    }
+    if (c->race_id == race_orc) {
+        hp *= 1.10;
+        p_atk *= 1.05;
+    }
+    if (c->race_id == race_elf) {
+        run += 6;
+        evasion += 3;
+    }
+
+    c->max_hp = hp * lvl_mul;
+    c->max_mp = mp * lvl_mul;
+    c->max_cp = cp * lvl_mul;
+    if (c->current_hp <= 0 || c->current_hp > c->max_hp)
+        c->current_hp = c->max_hp;
+    if (c->current_mp <= 0 || c->current_mp > c->max_mp)
+        c->current_mp = c->max_mp;
+    if (c->current_cp <= 0 || c->current_cp > c->max_cp)
+        c->current_cp = c->max_cp;
+    c->p_atk = (u32) (p_atk * lvl_mul);
+    c->p_def = (u32) (p_def * lvl_mul);
+    c->m_atk = (u32) (m_atk * lvl_mul);
+    c->m_def = (u32) (m_def * lvl_mul);
+    c->p_atk_speed = atk_spd;
+    c->m_atk_speed = cast_spd;
+    c->run_speed = run;
+    c->walk_speed = walk;
+    c->swim_run_speed = run / 2;
+    c->swim_walk_speed = walk / 2;
+    c->fly_run_speed = run;
+    c->fly_walk_speed = walk;
+    c->critical_hit = crit;
+    c->accuracy = acc;
+    c->evasion_rate = evasion;
+    c->max_load = 70000;
+    c->collision_radius = c->race_id == race_dwarf ? 8.0 : 9.0;
+    c->collision_height = c->race_id == race_dwarf ? 18.0 : 23.0;
+    c->movement_speed_multiplier = 1;
+    c->atk_speed_multiplier = 1;
+}
+
+static struct character *spawn_npc(struct state *state, s32 x, s32 y, s32 z)
+{
+    struct character *npc = 0;
+    for (u32 id = 1; id < countof(state->characters); id++) {
+        if (state->characters[id].active)
+            continue;
+        npc = state->characters + id;
+        break;
+    }
+    if (!npc)
+        return 0;
+    memset(npc, 0, sizeof(*npc));
+    npc->active = 1;
+    npc->in_world = 1;
+    swprintf(npc->name, countof(npc->name) - 1, L"%ls", L"Orc");
+    swprintf(npc->title, countof(npc->title) - 1, L"%ls", L"Orc");
+    npc->template_id = 500 + 1000000;
+    npc->x = x;
+    npc->y = y;
+    npc->z = z;
+    npc->collision_radius = 8;
+    npc->collision_height = 25;
+    npc->level = 10;
+    npc->current_hp = CFG_ORC_HP;
+    npc->max_hp = CFG_ORC_HP;
+    npc->current_mp = 102;
+    npc->max_mp = 102;
+    npc->attributes.str = 40;
+    npc->attributes.con = 43;
+    npc->attributes.dex = 30;
+    npc->attributes._int = 21;
+    npc->attributes.wit = 20;
+    npc->attributes.men = 10;
+    npc->p_atk = 41;
+    npc->p_def = 55;
+    npc->m_atk = 6;
+    npc->m_def = 45;
+    npc->p_atk_speed = 249;
+    npc->m_atk_speed = 227;
+    npc->walk_speed = 45;
+    npc->run_speed = 110;
+    npc->critical_hit = 20;
+    return npc;
+}
+
+// tell everybody that knows `c` to forget it, right now (not in the next
+// visibility pass): its slot/id may be reused by a new object.
+static void forget_everywhere(struct state *state, struct character *c)
+{
+    u32 id = get_character_id(state, c);
+    for (size_t i = 0; i < countof(state->characters); i++) {
+        struct character *observer = state->characters + i;
+        if (!knows(observer, id))
+            continue;
+        set_known(observer, id, 0);
+        if (observer->known_count)
+            observer->known_count--;
+        if (observer->active && observer->conn && observer != c)
+            push_response(observer->conn, 1,
+                          "%h", 0,
+                          "%c", 0x12,
+                          "%u", id,
+                          "%u", 0);
+    }
+}
+
+static void character_leave_world(struct state *state, struct character *c)
+{
+    if (!c || !c->active)
+        return;
+    forget_everywhere(state, c);
+    // whoever was targeting or fighting it lets go.
+    u32 id = get_character_id(state, c);
+    for (size_t i = 0; i < countof(state->characters); i++) {
+        struct character *other = state->characters + i;
+        if (!other->active)
+            continue;
+        if (other->target_id == id)
+            other->target_id = 0;
+        if (other->last_attacker_id == id)
+            other->last_attacker_id = 0;
+    }
+    memset(c->known, 0, sizeof(c->known));
+    c->known_count = 0;
+    c->in_world = 0;
+    c->active = 0;
+}
+
+static void send_npc_info(struct state *state, struct character *to, struct character *npc)
+{
+    u32 attackable = 1;
+    u32 abnormal = state->now_ms < npc->stunned_until_ms ? 0x0040 : 0;
+    push_response(to->conn, 1,
+                  "%h", 0,
+                  "%c", 0x16,
+                  "%u", get_character_id(state, npc),
+                  "%u", npc->template_id,
+                  "%u", attackable,
+                  "%u", npc->x,
+                  "%u", npc->y,
+                  "%u", npc->z,
+                  "%u", npc->heading,
+                  "%u", 0,
+                  "%u", npc->m_atk_speed,
+                  "%u", npc->p_atk_speed,
+                  "%u", npc->run_speed,
+                  "%u", npc->walk_speed,
+                  // swim speed
+                  "%u", npc->run_speed,
+                  "%u", npc->walk_speed,
+                  // fly speed
+                  "%u", npc->run_speed,
+                  "%u", npc->walk_speed,
+                  "%u", npc->run_speed,
+                  "%u", npc->walk_speed,
+                  "%lf", 1.0,
+                  "%lf", 1.0,
+                  "%lf", npc->collision_radius,
+                  "%lf", npc->collision_height,
+                  // right hand weapon
+                  "%u", 0,
+                  // chest
+                  "%u", 0,
+                  // left hand weapon
+                  "%u", 0,
+                  "%c", 1,
+                  // running?
+                  "%c", 1,
+                  // combat?
+                  "%c", npc->action_type == attacking,
+                  // alike dead?
+                  "%c", npc->current_hp <= 0.0,
+                  // summoned?
+                  "%c", 0,
+                  "%ls", countof(npc->name), npc->name,
+                  "%ls", countof(npc->title), npc->title,
+                  "%u", 0,
+                  "%u", 0,
+                  "%u", 0,
+                  // abnormal effect (0x40 = stunned)
+                  "%u", abnormal,
+                  // clan id, crest, ally id, ally crest
+                  "%u", 0,
+                  "%u", 0,
+                  "%u", 0,
+                  "%u", 0,
+                  "%c", 0,
+                  // aura color
+                  "%c", 0,
+                  "%lf", npc->collision_radius,
+                  "%lf", npc->collision_height,
+                  "%u", 0);
+    // if it's walking, tell the newcomer where to.
+    if (npc->action_type == moving && npc->action_payload.moving.duration_ms)
+        push_response(to->conn, 1,
+                      "%h", 0,
+                      "%c", 0x01,
+                      "%u", get_character_id(state, npc),
+                      "%u", npc->action_payload.moving.target_x,
+                      "%u", npc->action_payload.moving.target_y,
+                      "%u", npc->action_payload.moving.target_z,
+                      "%u", npc->x,
+                      "%u", npc->y,
+                      "%u", npc->z);
+}
